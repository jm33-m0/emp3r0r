{
  "name": "bettercap",
  "build": "",
  "author": "jm33-ng",
  "date": "2022-03-09",
  "comment": "Run bettercap as an interactive shell",
  "is_local": false,
  "platform": "Linux",
  "path": "",
  "parameters": [
    {
      "name": "args",
      "description": "run bettercap with this commandline arg",
      "default": "",
