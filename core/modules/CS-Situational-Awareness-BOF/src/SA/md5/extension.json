{
    "name": "MD5 (SA)",
    "version": "0.0.0",
    "command_name": "sa-md5",
    "extension_author": "c2biz",
    "original_author": "TrustedSec",
    "repo_url": "https://github.com/sliverarmory/CS-Situational-Awareness-BOF",
    "help": "Calculates the MD5 hash of a file.",
    "long_help": "Computes and displays the MD5 (128-bit) hash of a file using the Windows CryptoAPI. Useful for file integrity verification or comparing files. Note: MD5 is cryptographically broken and should not be used for security purposes.",
    "depends_on": "coff-loader",
    "entrypoint": "go",
    "files": [
        {
            "os": "windows",
            "arch": "amd64",
            "path": "md5.x64.o"
        },
        {
            "os": "windows",
            "arch": "386",
            "path": "md5.x86.o"
        }
    ],
    "arguments": [
        {
            "name": "filepath",
            "desc": "The file path to hash",
            "type": "string",
            "optional": false
        }
    ]
}
