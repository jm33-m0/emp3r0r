{
  "name": "elvish",
  "build": "",
  "author": "jm33-ng",
  "date": "2025-01-06",
  "comment": "Run Elvish cross-platform interactive shell",
  "is_local": false,
  "platform": "Linux",
  "path": "",
  "parameters": [
    {
      "name": "args",
      "description": "run elvish with this commandline arg",
      "default": "--",
      "type": "string"
    }
  ],
  "agent_config": {
    "exec": "elvish",
    "files": [
      "elvish"
    ],
    "in_memory": false,
    "type": "elf",
    "interactive": true
  },
  "invocation": {
    "argv": [
      {
        "literal": "elvish"
      },
      {
        "param": "args"
      }
    ]
  }
}