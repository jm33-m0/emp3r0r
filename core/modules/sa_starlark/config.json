    "build": "",
    "author": "jm33-ng",
    "date": "2026-07-13",
    "comment": "LDAP search using Starlark",
    "is_local": false,
    "platform": "Windows",
    "path": "",
    "fileless": true,
    "parameters": [
      {
        "name": "filter",
        "description": "LDAP filter",
        "default": "(objectclass=*)",
        "type": "string",
        "required": true
      },
      {
        "name": "attributes",
        "description": "Comma separated list of attributes to return",
        "default": "",
        "type": "string",
        "required": false
      },
      {
        "name": "results_count",
        "description": "Maximum number of results to return",
        "default": "0",
        "type": "int",
        "required": false
      },
      {
        "name": "scope",
        "description": "Search scope (0=base, 1=onelevel, 2=subtree)",
        "default": "0",
        "type": "int",
        "required": false
      },
      {
        "name": "hostname",
        "description": "Target Domain Controller hostname",
        "default": "",
        "type": "string",
        "required": false
      },
      {
        "name": "domain",
        "description": "Target domain DN (e.g. DC=example,DC=com)",
        "default": "",
        "type": "string",
        "required": false
      },
      {
        "name": "ldaps",
        "description": "Use LDAPS (true/false)",
        "default": "false",
        "type": "bool",
        "required": false
      }
    ],
    "agent_config": {
      "exec": "ldapsearch.star",
      "files": ["ldapsearch.star"],
      "in_memory": true,
      "type": "starlark",
      "interactive": false
    },
    "invocation": {
      "argv": [
        {
          "param": "filter"
        },
        {
          "param": "attributes"
        },
        {
          "param": "results_count"
        },
        {
          "param": "scope"
        },
        {
          "param": "hostname"
        },
        {
          "param": "domain"
        },
        {
          "param": "ldaps"
        }
      ]
    }
  }
